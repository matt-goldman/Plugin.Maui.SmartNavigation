<?xml version="1.0" encoding="utf-8" ?>
<mct:BasePopup
    x:Class="DemoProject.Popups.Pages.Mct.MessagePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:DemoProject.Popups.Pages.Mct"
    x:DataType="mct:MessagePopup"
    PopupTitle="{Binding Message.Title}">
    <mct:BasePopup.BasePopupContent>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label
                FontSize="16"
                HorizontalOptions="Center"
                Text="{Binding Message.Message}" />
            <Button
                Clicked="OnCloseClicked"
                HorizontalOptions="Center"
                Text="Submit" />
        </VerticalStackLayout>
    </mct:BasePopup.BasePopupContent>
</mct:BasePopup>