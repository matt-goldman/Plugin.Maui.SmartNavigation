<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DemoProject.Popups.Pages.Mct.Loader.LoadingPopups"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="LoadingPopups">
    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Button Clicked="OnLoaderPopup_Clicked"
                    HorizontalOptions="Fill"
                    Text="Load Popup" />

            <Button Clicked="TryFinallyExample_Clicked"
                    HorizontalOptions="Fill"
                    Text="Try finally statement" />

            <Button Clicked="WithErrorMessage_Clicked"
                    HorizontalOptions="Fill"
                    Text="Test with error message" />

            <Button Clicked="WithCustomText_Clicked"
                    HorizontalOptions="Fill"
                    Text="Custom text" />

            <Button Clicked="ChangingMessage_Clicked"
                    HorizontalOptions="Fill"
                    Text="Changing Text" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>