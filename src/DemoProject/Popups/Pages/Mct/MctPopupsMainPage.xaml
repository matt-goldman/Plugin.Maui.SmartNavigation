<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DemoProject.Popups.Pages.Mct.MctPopupsMainPage"
             Title="MctPopupsMainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">

            <Button Clicked="OnMessagePopup_Clicked"
                    HorizontalOptions="Fill"
                    Text="Message Popup" />

            <Button Clicked="OnAddPopup_Clicked"
                    HorizontalOptions="Fill"
                    Text="Add Popup" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>